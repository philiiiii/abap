CLASS zcl_ewm_asb_base DEFINITION
  PUBLIC
  CREATE PUBLIC.

  PUBLIC SECTION.
    METHODS port_bin_ready
      IMPORTING iv_bin_id   TYPE string
                iv_x_row    TYPE zewm_de_transf_row
                iv_y_column TYPE zewm_de_transf_column
      RAISING   zcx_ewm_asb_interface.

  PROTECTED SECTION.
    METHODS get_storage_type
      IMPORTING it_huhdr               TYPE /scwm/tt_huhdr_int
      RETURNING VALUE(rf_storage_type) TYPE /scwm/de_lgtyp
      RAISING /pris/cx_ewm_asd_base.

    METHODS get_pmat_top
      IMPORTING if_bin_id          TYPE string
                it_huhdr           TYPE /scwm/tt_huhdr_int
      RETURNING VALUE(rf_pmat_top) TYPE /scwm/de_pmat.

    METHODS get_pmat_sub
      IMPORTING if_bin_id          TYPE string
                it_huhdr           TYPE /scwm/tt_huhdr_int
      RETURNING VALUE(rf_pmat_top) TYPE /scwm/de_pmat.

ENDCLASS.

CLASS zcl_ewm_asb_base IMPLEMENTATION.

  METHOD port_bin_ready.

  ENDMETHOD.

  METHOD get_storage_type.
    DATA lv_msg TYPE string ##NEEDED.

    mo_log->add_program_info( ).

    TRY.
        rf_storage_type = it_huhdr[ 1 ]-lgtyp.

        " 'HU Lagertyp: <&1>'
        MESSAGE i088(zewm_prismat_ext) WITH rf_storage_type INTO lv_msg.
        mo_log->add_message( ).

      CATCH cx_sy_itab_line_not_found.
        CLEAR rf_storage_type.
    ENDTRY.

    mo_log->add_program_info( iv_end = abap_true ).
  ENDMETHOD.

  METHOD get_pmat_top.
    DATA lv_msg TYPE string ##NEEDED.

    mo_log->add_program_info( ).

    TRY.
        rf_pmat_top = it_huhdr[ huident = if_bin_id ]-pmat.

        " 'Packmaterial Top-HU: <&1>'
        MESSAGE i089(zewm_prismat_ext) WITH rf_pmat_top INTO lv_msg.
        mo_log->add_message( ).

      CATCH cx_sy_itab_line_not_found.
        " 'HU <&1> nicht gefunden.'
        MESSAGE e090(zewm_prismat_ext) WITH if_bin_id INTO lv_msg.
        mo_log->add_message( ).
    ENDTRY.

    mo_log->add_program_info( iv_end = abap_true ).
  ENDMETHOD.

  METHOD get_pmat_sub.
    DATA lv_msg TYPE string ##NEEDED.

    mo_log->add_program_info( ).

    TRY.

        DATA(lt_huhdr) = it_huhdr.
        DELETE lt_huhdr WHERE huident = if_bin_id.

        IF lt_huhdr IS INITIAL.
          " 'HU <&1> hat keine Sub-HU's.'
          MESSAGE i092(zewm_prismat_ext) WITH if_bin_id INTO lv_msg.
        ENDIF.

        rf_pmat_top = it_huhdr[ huident = if_bin_id ]-pmat.

        " 'Packmaterial Sub-HU: <&1>'
        MESSAGE i091(zewm_prismat_ext) WITH rf_pmat_top INTO lv_msg.
        mo_log->add_message( ).

      CATCH cx_sy_itab_line_not_found.
        " 'HU <&1> nicht gefunden.'
        MESSAGE e091(zewm_prismat_ext) WITH if_bin_id INTO lv_msg.
        mo_log->add_message( ).
    ENDTRY.

    mo_log->add_program_info( iv_end = abap_true ).
  ENDMETHOD.
ENDCLASS.
