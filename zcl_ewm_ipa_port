CLASS zcl_ewm_ipa_port DEFINITION
  PUBLIC CREATE PUBLIC.

  PUBLIC SECTION.
    INTERFACES zif_ewm_ipa_port.

    METHODS constructor IMPORTING iv_lgnum TYPE /scwm/lgnum
                                  io_log   TYPE REF TO zcl_ewm_applog.

    ALIASES open_port     FOR zif_ewm_ipa_port~open_port.
    ALIASES open_bin      FOR zif_ewm_ipa_port~open_bin.
    ALIASES get_bin_state FOR zif_ewm_ipa_port~get_bin_state.
    ALIASES close_bin     FOR zif_ewm_ipa_port~close_bin.
    ALIASES close_port    FOR zif_ewm_ipa_port~close_port.

  PROTECTED SECTION.
    TYPES:
      BEGIN OF ts_asb,
        lgnum    TYPE /scwm/lgnum,
        port_id  TYPE zewm_de_ipa_port_id,
        instance TYPE REF TO zcl_ewm_asb_base,
      END OF ts_asb.

    DATA mv_lgnum TYPE /scwm/lgnum.
    DATA mo_log   TYPE REF TO zcl_ewm_applog.
    DATA mt_asb   TYPE HASHED TABLE OF ts_asb WITH UNIQUE KEY lgnum port_id.

    METHODS get_asb
      IMPORTING iv_lgnum      TYPE /scwm/lgnum
                iv_port_id    TYPE zewm_de_ipa_port_id
      RETURNING VALUE(ro_asb) TYPE REF TO zcl_ewm_asb_base
      RAISING   zcx_ewm_ipa.

    METHODS raise_asb
      IMPORTING if_port_id  TYPE zewm_de_ipa_port_id
                if_code     TYPE zewm_de_ipa_as_err_code OPTIONAL
                io_previous TYPE REF TO cx_root       OPTIONAL
      RAISING   zcx_ewm_ipa.

  PRIVATE SECTION.
ENDCLASS.

CLASS zcl_ewm_ipa_port IMPLEMENTATION.
  METHOD constructor.
    mv_lgnum = iv_lgnum.
    mo_log = io_log.
  ENDMETHOD.

  METHOD get_asb.
    mo_log->add_program_info( iv_end = abap_false ).

    ASSIGN mt_asb[ lgnum   = iv_lgnum
                   port_id = iv_port_id ] TO FIELD-SYMBOL(<ls_asb>).
    IF sy-subrc = 0.
      ro_asb = <ls_asb>-instance.
      mo_log->add_program_info( iv_end = abap_true ).
      RETURN.
    ENDIF.

    SELECT as_lgtyp, workstation FROM zewm_ipa_i_asd_workst
      WHERE lgnum   = @iv_lgnum
        AND port_id = @iv_port_id
      ORDER BY workstation
      INTO @DATA(ls_workstation)
      UP TO 1 ROWS.
    ENDSELECT.
    IF sy-subrc <> 0.
      MESSAGE e066(zewm_ipa) WITH iv_port_id INTO lf_msg.
      mo_log->add_message( ).
      mo_log->add_program_info( iv_end = abap_true ).
      RAISE EXCEPTION TYPE zcx_ewm_ipa
            MESSAGE e066(zewm_ipa) WITH if_port_id
            EXPORTING iv_as_err_info = CONV zewm_ipa_as_err_info( iv_port_id ).
    ENDIF.

    TRY.
        ro_asb = NEW zcl_ewm_asb_base( iv_lgnum       = iv_lgnum
                                       iv_workstation = ls_workstation-workstation
                                       io_log         = mo_log ).
      CATCH zcx_ewm_asd_base INTO DATA(lx_asb).
        mo_log->add_program_info( iv_end = abap_true ).
        raise_asb( iv_port_id  = iv_port_id
                   io_previous = lx_asb ).
    ENDTRY.

    INSERT VALUE #( lgnum    = iv_lgnum
                    port_id  = iv_port_id
                    instance = ro_asb ) INTO TABLE mt_asb.

    mo_log->add_program_info( iv_end = abap_true ).
  ENDMETHOD.

  METHOD raise_asb.
    DATA lv_msg TYPE string ##NEEDED.

    DATA(lv_text) = COND sy-msgv1(
      WHEN iv_code IS NOT INITIAL THEN iv_code
      WHEN io_previous IS BOUND   THEN io_previous->get_text( )
      ELSE                             '?' ).

    MESSAGE e065(zewm_ipa) WITH lf_text if_port_id INTO lf_msg.
    mo_log->add_message( ).

    RAISE EXCEPTION TYPE zcx_ewm_ipa
          MESSAGE e065(zewm_ipa) WITH lv_text if_port_id
          EXPORTING iv_as_err_code = if_code
                    iv_as_err_info = CONV zewm_ipa_as_err_info( iv_port_id )
                    previous       = io_previous.
  ENDMETHOD.

  METHOD zif_ewm_ipa_port~open_port.
    DATA lt_content TYPE zewm_tt_asb_numc5.

    mo_log->add_program_info( iv_end = abap_false ).

    TRY.
        APPEND INITIAL LINE TO lt_content ASSIGNING FIELD-SYMBOL(<ls_content>).
        <ls_content> = iv_content.

        DATA(lo_asb) = get_asb( iv_lgnum   = iv_lgnum
                                iv_port_id = iv_port_id    ).

        lo_asb->open_port_as( it_select_content = lt_content ).
      CATCH zcx_ewm_asd_base INTO DATA(lx_asb).
        mo_log->add_program_info( iv_end = abap_true ).
        raise_asb( iv_port_id  = iv_port_id
                   io_previous = lx_asb ).
    ENDTRY.

    mo_log->add_program_info( iv_end = abap_true ).
  ENDMETHOD.

  METHOD zif_ewm_ipa_port~open_bin.
    DATA lv_msg     TYPE string ##NEEDED.
    DATA lv_bin_id  TYPE numc7.
    DATA lv_task_id TYPE numc10.

    mo_log->add_program_info( iv_end = abap_false ).

    DATA(lo_asb) = get_asb( iv_lgnum   = iv_lgnum
                            iv_port_id = iv_port_id ).

    TRY.
        lo_asb->open_bin_as( EXPORTING iv_commit_prot = abap_true
                             IMPORTING ev_bin_id      = lv_bin_id
                                       ev_task_id     = lv_task_id ).
      CATCH zcx_ewm_asd_base INTO DATA(lx_asb).
        mo_log->add_program_info( iv_end = abap_true ).
        raise_asb( iv_port_id  = iv_port_id
                   io_previous = lx_asb ).
    ENDTRY.

    rs_bin = VALUE #( bin_id  = lv_bin_id
                      task_id = lv_task_id ).

    MESSAGE i067(zewm_ipa) WITH if_port_id rs_bin-bin_id rs_bin-task_id INTO lf_msg.
    mo_log->add_message( ).

    mo_log->add_program_info( iv_end = abap_true ).
  ENDMETHOD.

  METHOD zif_ewm_ipa_port~get_bin_state.
    DATA lt_bin_state TYPE zewm_tt_asb_bin_state.

    mo_log->add_program_info( iv_end = abap_false ).

    TRY.
        DATA(lo_asb) = get_asb( if_lgnum   = mf_lgnum
                                if_port_id = if_port_id ).

        lo_asb->get_bin_state_as( EXPORTING iv_bin_id    = CONV #( if_bin_id )
                                  IMPORTING et_bin_state = lt_bin_state ).

        rf_state = lt_bin_state[ 1 ]-bin_mode.
      CATCH cx_sy_itab_line_not_found INTO DATA(lx_line).
        raise_asb( if_port_id  = if_port_id
                   io_previous = lx_line ).
      CATCH /pris/cx_ewm_asd_base INTO DATA(lx_asb).
        raise_asb( if_port_id  = if_port_id
                   io_previous = lx_asb ).
    ENDTRY.

    mo_log->add_program_info( iv_end = abap_true ).
  ENDMETHOD.
