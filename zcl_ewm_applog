CLASS zcl_ewm_applog IMPLEMENTATION.
  METHOD add_log.
    IF it_prot IS NOT INITIAL.
      mo_ewm_log->add_log( it_prot = it_prot ).
    ENDIF.

    IF io_prot IS NOT INITIAL.
      mo_ewm_log->add_log( it_prot = io_prot->get_prot( ) ).
    ENDIF.
  ENDMETHOD.

  METHOD add_message.
    DATA lv_msgty TYPE symsgty.
    DATA lv_msgid TYPE symsgid.
    DATA lv_msgno TYPE symsgno.
    DATA lv_msgv1 TYPE symsgv.
    DATA lv_msgv2 TYPE symsgv.
    DATA lv_msgv3 TYPE symsgv.
    DATA lv_msgv4 TYPE symsgv.

    IF me->mo_std_log IS BOUND.
      IF ip_msgty IS NOT INITIAL.
        lv_msgty = ip_msgty.
      ELSEIF ip_msg IS INITIAL.
        lv_msgty = sy-msgty.
      ENDIF.

      IF ip_msgid IS NOT INITIAL.
        lv_msgid = ip_msgid.
      ELSEIF ip_msg IS INITIAL.
        lv_msgid = sy-msgid.
      ENDIF.

      IF ip_msgno IS NOT INITIAL.
        lv_msgno = ip_msgno.
      ELSEIF ip_msg IS INITIAL.
        lv_msgno = sy-msgno.
      ENDIF.

      IF ip_msgv1 IS NOT INITIAL.
        lv_msgv1 = ip_msgv1.
      ELSEIF ip_msg IS INITIAL.
        lv_msgv1 = sy-msgv1.
      ENDIF.

      IF ip_msgv2 IS NOT INITIAL.
        lv_msgv2 = ip_msgv2.
      ELSEIF ip_msg IS INITIAL.
        lv_msgv2 = sy-msgv2.
      ENDIF.

      IF ip_msgv3 IS NOT INITIAL.
        lv_msgv3 = ip_msgv3.
      ELSEIF ip_msg IS INITIAL.
        lv_msgv3 = sy-msgv3.
      ENDIF.

      IF ip_msgv4 IS NOT INITIAL.
        lv_msgv4 = ip_msgv4.
      ELSEIF ip_msg IS INITIAL.
        lv_msgv4 = sy-msgv4.
      ENDIF.

      me->mo_std_log->add_message( ip_msgty = lv_msgty
                                   ip_msgid = lv_msgid
                                   ip_msgno = lv_msgno
                                   ip_msgv1 = lv_msgv1
                                   ip_msgv2 = lv_msgv2
                                   ip_msgv3 = lv_msgv3
                                   ip_msgv4 = lv_msgv4
                                   ip_msg   = ip_msg
                                   ip_param = ip_param
                                   ip_row   = ip_row
                                   ip_field = ip_field ).
    ELSE.
      me->mo_ewm_log->add_message( iv_msgty = ip_msgty
                                   iv_msgid = ip_msgid
                                   iv_msgno = ip_msgno
                                   iv_msgv1 = ip_msgv1
                                   iv_msgv2 = ip_msgv2
                                   iv_msgv3 = ip_msgv3
                                   iv_msgv4 = ip_msgv4
                                   iv_msg   = ip_msg ).
    ENDIF.
  ENDMETHOD.

  METHOD add_message2bapiret.
    DATA ls_bapiret2 TYPE bapiret2.

    IF sy-msgty IS INITIAL.
      ls_bapiret2-type       = ip_msgty.
      ls_bapiret2-id         = ip_msgid.
      ls_bapiret2-number     = ip_msgno.
      ls_bapiret2-message    = ip_msg.
      ls_bapiret2-message_v1 = ip_msgv1.
      ls_bapiret2-message_v2 = ip_msgv2.
      ls_bapiret2-message_v3 = ip_msgv3.
      ls_bapiret2-message_v4 = ip_msgv4.
      ls_bapiret2-parameter  = ip_param.
      ls_bapiret2-row        = ip_row.
      ls_bapiret2-field      = ip_field.
    ELSE.
      ls_bapiret2-type       = sy-msgty.
      ls_bapiret2-id         = sy-msgid.
      ls_bapiret2-number     = sy-msgno.
      ls_bapiret2-message    = sy-msgv1.
      ls_bapiret2-message_v1 = sy-msgv2.
      ls_bapiret2-message_v2 = sy-msgv3.
      ls_bapiret2-message_v3 = sy-msgv4.
    ENDIF.

    APPEND ls_bapiret2 TO cs_bapiret.
  ENDMETHOD.

  METHOD add_message2log.
    DATA lv_msgv1 TYPE symsgv.
    DATA lv_msgv2 TYPE symsgv.
    DATA lv_msgv3 TYPE symsgv.
    DATA lv_msgv4 TYPE symsgv.
    DATA lv_msgty TYPE symsgty.
    DATA lv_msgid TYPE symsgid.
    DATA lv_msgno TYPE symsgno.

    IF ip_msgty IS NOT INITIAL.
      lv_msgty = ip_msgty.
    ELSE.
      lv_msgty = sy-msgty.
    ENDIF.

    IF ip_msgid IS NOT INITIAL.
      lv_msgid = ip_msgid.
    ELSE.
      lv_msgid = sy-msgid.
    ENDIF.

    IF ip_msgno IS NOT INITIAL.
      lv_msgno = ip_msgno.
    ELSE.
      lv_msgno = sy-msgno.
    ENDIF.

    IF ip_msgv1 IS NOT INITIAL.
      lv_msgv1 = condense( ip_msgv1 ).
    ELSE.
      lv_msgv1 = condense( sy-msgv1 ).
    ENDIF.

    IF ip_msgv2 IS NOT INITIAL.
      lv_msgv2 = condense( ip_msgv2 ).
    ELSE.
      lv_msgv2 = condense( sy-msgv2 ).
    ENDIF.

    IF ip_msgv3 IS NOT INITIAL.
      lv_msgv3 = condense( ip_msgv3 ).
    ELSE.
      lv_msgv3 = condense( sy-msgv3 ).
    ENDIF.

    IF ip_msgv4 IS NOT INITIAL.
      lv_msgv4 = condense( ip_msgv4 ).
    ELSE.
      lv_msgv4 = condense( sy-msgv4 ).
    ENDIF.

    IF me->mo_std_log IS NOT BOUND.
* Add message to application log ().
      DATA ls_protocol  TYPE bal_s_msg.
      DATA lv_loghandle TYPE balloghndl.

* Don't write message, when global variable "gv_nolog" was set by constructor
      CHECK gv_nolog IS INITIAL.

      IF    ip_msgno IS SUPPLIED
         OR ip_msg   IS SUPPLIED.
        IF     gv_no_info IS NOT INITIAL
           AND ip_msgty    = 'I'.
          RETURN.
        ENDIF.

        ls_protocol-msgty    = ip_msgty.
        ls_protocol-msgid    = ip_msgid.
        ls_protocol-msgno    = ip_msgno.
        ls_protocol-msgv1    = ip_msgv1.
        ls_protocol-msgv2    = ip_msgv2.
        ls_protocol-msgv3    = ip_msgv3.
        ls_protocol-msgv4    = ip_msgv4.
        ls_protocol-alsort   = ip_row.
        ls_protocol-detlevel = ip_detlvl.
      ELSE.
        IF     gv_no_info IS NOT INITIAL
           AND sy-msgty    = 'I'.
          RETURN.
        ENDIF.

        ls_protocol-msgty    = sy-msgty.
        ls_protocol-msgid    = sy-msgid.
        ls_protocol-msgno    = sy-msgno.
        ls_protocol-msgv1    = sy-msgv1.
        ls_protocol-msgv2    = sy-msgv2.
        ls_protocol-msgv3    = sy-msgv3.
        ls_protocol-msgv4    = sy-msgv4.
        ls_protocol-alsort   = ip_row.
        ls_protocol-detlevel = ip_detlvl.
      ENDIF.

* Check message type / severeness
      CASE sy-msgty.
        WHEN 'S'.
          ls_protocol-probclass = '4'.
        WHEN 'I'.
          ls_protocol-probclass = '4'.
        WHEN 'W'.
          ls_protocol-probclass = '3'.
        WHEN 'E'.
          ls_protocol-probclass = '2'.
        WHEN 'A'.
          ls_protocol-probclass = '1'.
        WHEN OTHERS.
          ls_protocol-probclass = '4'.
      ENDCASE.

* Get Loghandle
      IF ip_loghandle IS INITIAL.
        lv_loghandle = me->mo_ewm_log->get_loghndl( ).
      ELSE.
        lv_loghandle = ip_loghandle.
      ENDIF.

* Fill data into application log
      CALL FUNCTION 'BAL_LOG_MSG_ADD'
        EXPORTING  i_log_handle = lv_loghandle
                   i_s_msg      = ls_protocol
        EXCEPTIONS OTHERS       = 4.
      IF sy-subrc <> 0.
        RETURN.
      ENDIF.

      me->determ_severity( ip_msgty  = ls_protocol-msgty
                           is_balmsg = ls_protocol ).
    ELSE.
      me->mo_std_log->add_message2log( ip_msgty     = lv_msgty
                                       ip_msgid     = lv_msgid
                                       ip_msgno     = lv_msgno
                                       ip_msgv1     = lv_msgv1
                                       ip_msgv2     = lv_msgv2
                                       ip_msgv3     = lv_msgv3
                                       ip_msgv4     = lv_msgv4
                                       ip_msg       = ip_msg
                                       ip_param     = ip_param
                                       ip_row       = ip_row
                                       ip_field     = ip_field
                                       ip_detlvl    = ip_detlvl
                                       ip_loghandle = ip_loghandle ).
    ENDIF.
  ENDMETHOD.

  METHOD add_message_with_decoration.
    DATA lv_msgty    TYPE symsgty.
    DATA lv_msgv1    TYPE symsgv.
    DATA lv_msgv2    TYPE symsgv.
    DATA lv_msgv3    TYPE symsgv.
    DATA lv_msgv4    TYPE symsgv.
    DATA lv_msgid    TYPE symsgid.
    DATA lv_msgno    TYPE symsgno.
    DATA lv_msg      TYPE string ##NEEDED.

    DATA lv_sy_msgty TYPE symsgty.
    DATA lv_sy_msgid TYPE symsgid.
    DATA lv_sy_msgno TYPE symsgno.
    DATA lv_sy_msgv1 TYPE symsgv.
    DATA lv_sy_msgv2 TYPE symsgv.
    DATA lv_sy_msgv3 TYPE symsgv.
    DATA lv_sy_msgv4 TYPE symsgv.

*  *********************************************************************
*  ** Systemvariablen zwischenspeichern ********************************
*  *********************************************************************
    lv_sy_msgty = sy-msgty.
    lv_sy_msgid = sy-msgid.
    lv_sy_msgno = sy-msgno.
    lv_sy_msgv1 = sy-msgv1.
    lv_sy_msgv2 = sy-msgv2.
    lv_sy_msgv3 = sy-msgv3.
    lv_sy_msgv4 = sy-msgv4.
*  *********************************************************************

*     add overline
    IF iv_overline IS NOT INITIAL.
      add_separator( iv_separator_char = iv_overline
                     iv_msgty          = iv_msgty ).
    ENDIF.

    IF iv_msg IS NOT INITIAL AND iv_msgid IS INITIAL AND iv_msgno IS INITIAL.
      lv_msgty = iv_msgty.
      lv_msgid = '/PRIS/APPLOG_MSG'.
      lv_msgno = '010'.
    ELSEIF iv_msgid IS INITIAL AND iv_msgno IS INITIAL.
      lv_msgty = lv_sy_msgty.
      lv_msgid = lv_sy_msgid.
      lv_msgno = lv_sy_msgno.
    ELSE.
      lv_msgty = iv_msgty.
      lv_msgid = iv_msgid.
      lv_msgno = iv_msgno.
    ENDIF.

    IF iv_msgv1 IS NOT INITIAL.
      lv_msgv1 = iv_msgv1.
      lv_msgv2 = iv_msgv2.
      lv_msgv3 = iv_msgv3.
      lv_msgv4 = iv_msgv4.
    ELSEIF lv_sy_msgv1 IS NOT INITIAL.
      lv_msgv1 = lv_sy_msgv1.
      lv_msgv2 = lv_sy_msgv2.
      lv_msgv3 = lv_sy_msgv3.
      lv_msgv4 = lv_sy_msgv4.
    ENDIF.

*   determine length of message and split
    IF iv_msg IS NOT INITIAL.
      CLEAR: lv_msgv1,
             lv_msgv2,
             lv_msgv3,
             lv_msgv4.

      IF strlen( iv_msg ) <= 50.
        lv_msgv1 = iv_msg.
      ELSE.
        lv_msgv1 = iv_msg(50).
        IF strlen( iv_msg ) <= 100.
          lv_msgv2 = iv_msg+50.
        ELSE.
          lv_msgv2 = iv_msg+50(50).
          IF strlen( iv_msg ) > 100.
            lv_msgv3 = iv_msg+100.
          ELSE.
            lv_msgv3 = iv_msg+100(50).
            IF strlen( iv_msg ) > 150.
              lv_msgv4 = iv_msg+150.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.

*   add message
    add_message( ip_msgty = lv_msgty
                 ip_msgid = lv_msgid
                 ip_msgno = lv_msgno
                 ip_msgv1 = lv_msgv1
                 ip_msgv2 = lv_msgv2
                 ip_msgv3 = lv_msgv3
                 ip_msgv4 = lv_msgv4
                 ip_msg   = iv_msg
                 ip_param = iv_param
                 ip_row   = iv_row
                 ip_field = iv_field ).

*   add underline
    IF iv_underline IS NOT INITIAL.
      add_separator( iv_separator_char = iv_underline
                     iv_msgty          = iv_msgty ).
    ENDIF.

*  *********************************************************************
*  ** Systemvariablen "zurückschreiben" durch Message ******************
*  *********************************************************************
    IF lv_sy_msgid IS NOT INITIAL AND lv_sy_msgty IS NOT INITIAL AND lv_sy_msgno IS NOT INITIAL.
      MESSAGE ID lv_sy_msgid TYPE lv_sy_msgty NUMBER lv_sy_msgno
              WITH lv_sy_msgv1 lv_sy_msgv2 lv_sy_msgv3 lv_sy_msgv4
              INTO lv_msg.
    ENDIF.
*  *********************************************************************
  ENDMETHOD.

  METHOD add_program_info.
    " TODO: parameter IV_OVERLINE is never used (ABAP cleaner)
    " TODO: parameter IV_UNDERLINE is never used (ABAP cleaner)

    DATA lv_depth TYPE /pris/main_de_depth_call_stack.

    lv_depth = iv_depth.

    mo_ewm_log->add_program_info( iv_end   = iv_end
