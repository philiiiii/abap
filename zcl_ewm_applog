  METHOD get_timestamp.
*    DATA:  lv_tstamp    TYPE timestampl,
*           lv_tzone     TYPE tznzone,
*           lv_nano_secs TYPE p DECIMALS 7,
*           lv_date      TYPE d,
*           lv_time      TYPE t,
*           lv_output    TYPE c LENGTH 27,
*           lv_msg       TYPE string.
*
**   aktuelle Timestamp ermitteln
*    GET TIME STAMP FIELD lv_tstamp.
*
*    IF mv_lgnum IS NOT INITIAL.
**     Zeitzone zur Lagernummer ermitteln
*      CALL FUNCTION '/SCWM/LGNUM_TZONE_READ'
*        EXPORTING
*          iv_lgnum        = mv_lgnum
*        IMPORTING
*          ev_tzone        = lv_tzone
*        EXCEPTIONS
*          interface_error = 1
*          data_not_found  = 2
*          OTHERS          = 3.
*      IF sy-subrc <> 0.
*        lv_tzone = sy-zonlo.
*      ENDIF.
*
**     Nanosekunden ermitteln
*      lv_nano_secs = frac( lv_tstamp ).
*
**     Timestamp in Datum und Zeit konvertieren
*      CONVERT TIME STAMP lv_tstamp TIME ZONE lv_tzone
*        INTO DATE lv_date TIME lv_time.
*
**     Datum und Zeit formatieren
*      WRITE: lv_date      TO lv_output(10),
*      lv_time      TO lv_output+11(8),
*      lv_nano_secs TO lv_output+19(8).
*
*      rv_timestamp = lv_output.
*    ELSE.
*      rv_timestamp = lv_tstamp.
*    ENDIF.

    DATA lv_tstamp    TYPE timestampl.
    DATA lv_nano_secs TYPE p LENGTH 8 DECIMALS 7.
    DATA lv_date      TYPE d.
    DATA lv_time      TYPE t.
    DATA lv_output    TYPE c LENGTH 27.

    " get timestamp
    GET TIME STAMP FIELD lv_tstamp.

    " determine Nanoseconds
    lv_nano_secs = frac( lv_tstamp ).

    " Convert timestamp to date and time
    CONVERT TIME STAMP lv_tstamp TIME ZONE sy-zonlo
            INTO DATE lv_date TIME lv_time.

    " Convert date and time
    WRITE: lv_date      TO lv_output(10),
           lv_time      TO lv_output+11(8),
           lv_nano_secs TO lv_output+19(8).

    rv_timestamp = lv_output.
  ENDMETHOD.

