  METHOD convert_probclass_to_msgty.
    CASE iv_probclass.
      WHEN '1'.
        rv_msgty = 'AEX'.
      WHEN '2'.
        rv_msgty = 'AEWX'.
      WHEN '3'.
        rv_msgty = 'AEWIX'.
