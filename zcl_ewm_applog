  METHOD determ_probclass.
    FIELD-SYMBOLS <ls_msgtype_probclass> TYPE /pris/s_msgtype_probclass.

    LOOP AT me->mt_msgtype_probclass ASSIGNING <ls_msgtype_probclass>.
      IF    (     <ls_msgtype_probclass>-index_start <= iv_index
              AND <ls_msgtype_probclass>-index_end   >= iv_index )
         OR (     <ls_msgtype_probclass>-index_start <= iv_index
              AND <ls_msgtype_probclass>-index_end    < 0 ).
        rv_probclass = <ls_msgtype_probclass>-probclass.
        RETURN.
      ENDIF.
    ENDLOOP.

    ASSIGN me->mt_msgtype_probclass[ msgty = iv_msgty ] TO <ls_msgtype_probclass>.
    IF sy-subrc = 0.
      rv_probclass = <ls_msgtype_probclass>-probclass.
    ELSE.
      rv_probclass = '4'.
    ENDIF.
  ENDMETHOD.

  METHOD determ_severity.
    IF me->mo_std_log IS NOT BOUND.
      FIELD-SYMBOLS <fs_prot> LIKE LINE OF it_prot.
      DATA lf_severity LIKE mp_severity.

      LOOP AT it_prot ASSIGNING <fs_prot>.
        CASE <fs_prot>-type.
          WHEN 'A'.
            lf_severity = <fs_prot>-type.
            EXIT.
          WHEN 'E'.
            lf_severity = <fs_prot>-type.
          WHEN 'W'.
            IF lf_severity <> 'E'.
              lf_severity = <fs_prot>-type.
            ENDIF.
          WHEN 'I'.
            IF lf_severity IS INITIAL.
              lf_severity = <fs_prot>-type.
            ENDIF.
          WHEN 'S'.
            IF lf_severity IS INITIAL.
              lf_severity = 'I'.
            ENDIF.
        ENDCASE.
      ENDLOOP.

      IF    ( lf_severity = 'A' OR  lf_severity  = 'E' )
* abort message occurred
         OR ( lf_severity = 'W' AND mp_severity <> 'E' )
* warning
         OR ( lf_severity = 'I' AND mp_severity IS INITIAL ).
* info
        mp_severity = lf_severity.
      ENDIF.

      IF is_msg IS NOT INITIAL.
        lf_severity = is_msg-type.
        IF lf_severity = 'S'.
          lf_severity = 'I'.
        ENDIF.

        IF    ( lf_severity = 'A' OR  lf_severity  = 'E' )
* abort message occurred
           OR ( lf_severity = 'W' AND mp_severity <> 'E' )
* warning
           OR ( lf_severity = 'I' AND mp_severity IS INITIAL ).
* info
          mp_severity = lf_severity.
        ENDIF.
      ENDIF.

      IF is_balmsg IS NOT INITIAL.
        CASE is_balmsg-probclass.
          WHEN '4'.
            lf_severity = 'I'.
          WHEN '3'.
            lf_severity = 'W'.
          WHEN '2'.
            lf_severity = 'E'.
          WHEN '1'.
            lf_severity = 'A'.
          WHEN OTHERS.
        ENDCASE.
      ENDIF.

      IF    ( lf_severity = 'A' OR  lf_severity  = 'E' )
* abort message occurred
         OR ( lf_severity = 'W' AND mp_severity <> 'E' )
* warning
         OR ( lf_severity = 'I' AND mp_severity IS INITIAL ).
* info
        mp_severity = lf_severity.
      ENDIF.

      ev_severity = lf_severity.
    ELSE.
      ev_severity = me->mo_std_log->determ_severity( is_msg    = is_msg
                                                     it_prot   = it_prot
                                                     ip_msgty  = ip_msgty
                                                     is_balmsg = is_balmsg ).
    ENDIF.
  ENDMETHOD.

