        EXPORTING  i_t_log_handle     = lt_logh
        EXCEPTIONS no_logs_specified  = 1
                   log_not_found      = 2
                   log_already_loaded = 3
                   OTHERS             = 4.

      IF me->mo_std_log->mp_protocol IS NOT INITIAL.
        convert_bapiret2log_w_lghndl( iv_loghndl = lv_loghandle ).

        CLEAR me->mo_std_log->mp_protocol.
      ENDIF.

      me->mo_std_log->save_applog2db( EXPORTING iv_loghandle = lv_loghandle
                                      IMPORTING es_lognumber = es_lognumber ).
    ELSE.
      TRY.
