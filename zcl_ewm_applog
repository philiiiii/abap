    " zu vermeiden. der übertrag erfolgt in save_applog bzw save_applog2db
  ENDMETHOD.

  METHOD condense.
*    IF iv_value_from IS INITIAL.
*      RETURN.
*    ENDIF.
*
*    rv_value_to = iv_value_from.
*
*    IF me->mv_condense EQ abap_true.
*      CONDENSE rv_value_to.
*      SHIFT rv_value_to LEFT DELETING LEADING '0'.
*    ENDIF.

    rv_value_to = mo_ewm_log->condense( iv_value_from ).
  ENDMETHOD.

  METHOD constructor.
    DATA lv_object    TYPE balobj_d.
    DATA lv_subobject TYPE balsubobj.
    " TODO: variable is assigned but never used (ABAP cleaner)
    DATA lv_extnumber TYPE balnrext.

    IF iv_subobject IS INITIAL AND iv_loghndl IS INITIAL.
      RAISE EXCEPTION NEW /pris/cx_ewm_log_wrong_config( textid = /pris/cx_ewm_log_wrong_config=>wrong_parameters ).
    ENDIF.

    IF iv_loghndl IS NOT INITIAL.
      SELECT SINGLE object subobject FROM balhdr
        INTO ( lv_object, lv_subobject )
        WHERE log_handle = iv_loghndl.
    ELSE.
      lv_object = iv_object.
      lv_subobject = iv_subobject.
      lv_extnumber = iv_extnumber.
    ENDIF.

    super->constructor( iv_created_date = sy-datum
                        iv_created_time = sy-uzeit
                        iv_lgnum        = iv_lgnum
                        iv_balobj       = lv_object
                        iv_balsubobj    = lv_subobject ).

    TRY.
        me->mo_ewm_log = NEW #( iv_lgnum                   = iv_lgnum
                                iv_object                  = lv_object
                                iv_subobject               = lv_subobject
                                iv_extnumber               = iv_extnumber
                                iv_loghndl                 = iv_loghndl
                                iv_condense                = iv_condense
                                iv_add_timestamp_on_saving = iv_add_timestamp_on_saving
                                iv_proginfo_overline_char  = iv_proginfo_overline
                                iv_proginfo_underline_char = iv_proginfo_underline ).
      CATCH /pris/cx_main_log_config.
        RAISE EXCEPTION TYPE /pris/cx_ewm_log_wrong_config
              MESSAGE ID sy-msgid
              TYPE sy-msgty
              NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDTRY.

    mo_std_log = io_std_log.
  ENDMETHOD.

  METHOD convert_bapiret2applog.
    IF me->mo_std_log IS NOT BOUND.
      FIELD-SYMBOLS <prot> TYPE bapiret2.
      DATA lt_bapiret TYPE bapirettab.

      DATA ls_msg     TYPE bal_s_msg.

      CLEAR ev_loghandle.

      IF it_bapiret IS NOT INITIAL.
        lt_bapiret = it_bapiret.
      ELSE.
        lt_bapiret = me->mo_ewm_log->get_prot( ).
      ENDIF.

* Get Log Handle
      ev_loghandle = me->mo_ewm_log->get_loghndl( ).

      LOOP AT lt_bapiret ASSIGNING <prot>.
*   do not add 'I' messages if set globally
        IF     gv_no_info  IS NOT INITIAL
           AND <prot>-type  = 'I'.
          CONTINUE.
        ENDIF.

*   Put Log data into internal table
        CLEAR ls_msg.
        ls_msg-msgty  = <prot>-type.
        ls_msg-msgid  = <prot>-id.
        ls_msg-msgno  = <prot>-number.
        ls_msg-msgv1  = <prot>-message_v1.
        ls_msg-msgv2  = <prot>-message_v2.
        ls_msg-msgv3  = <prot>-message_v3.
        ls_msg-msgv4  = <prot>-message_v4.
        ls_msg-alsort = <prot>-row.
        IF iv_group IS NOT INITIAL.
          ls_msg-alsort = iv_group.
        ENDIF.
        CASE <prot>-type.
          WHEN 'S'.
            ls_msg-probclass = '4'.
          WHEN 'I'.
            ls_msg-probclass = '4'.
          WHEN 'W'.
            ls_msg-probclass = '3'.
          WHEN 'E'.
            ls_msg-probclass = '2'.
          WHEN 'A'.
            ls_msg-probclass = '1'.
          WHEN OTHERS.
            ls_msg-probclass = '4'.
        ENDCASE.

*   Fill data into application log
        IF <prot>-number IS NOT INITIAL.
          CALL FUNCTION 'BAL_LOG_MSG_ADD'
            EXPORTING  i_log_handle = ev_loghandle
                       i_s_msg      = ls_msg
            EXCEPTIONS OTHERS       = 4.
          IF sy-subrc <> 0.
            EXIT.
          ENDIF.
        ELSEIF <prot>-message IS NOT INITIAL.
          CALL FUNCTION 'BAL_LOG_MSG_ADD_FREE_TEXT'
            EXPORTING  i_log_handle = ev_loghandle
                       i_msgty      = <prot>-type
                       i_probclass  = ls_msg-probclass
                       i_text       = <prot>-message
            EXCEPTIONS OTHERS       = 4.
          IF sy-subrc <> 0.
            EXIT.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ELSE.
      me->mo_std_log->convert_bapiret2applog( EXPORTING it_bapiret   = it_bapiret
                                                        iv_group     = iv_group
                                              IMPORTING ev_loghandle = ev_loghandle ).
    ENDIF.
  ENDMETHOD.

