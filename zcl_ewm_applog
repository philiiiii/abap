  METHOD save_applog2db.
    DATA lv_loghandle TYPE balloghndl.

    DATA lt_logh      TYPE bal_t_logh.

    lv_loghandle = iv_loghandle.

    IF me->mo_std_log IS BOUND.
      IF me->mv_add_timestamp_on_saving = abap_true.
        log_timestamp( ).
      ENDIF.

      IF lv_loghandle IS INITIAL.
        IF me->mo_std_log->mp_loghandle IS INITIAL.
          me->mo_std_log->save_applog( EXPORTING is_log       = me->mo_std_log->mp_log
                                       IMPORTING ev_loghandle = lv_loghandle ).
        ELSE.
          lv_loghandle = me->mo_std_log->mp_loghandle.

          me->mo_std_log->convert_bapiret2applog( ).

          CLEAR me->mo_std_log->mp_protocol.
        ENDIF.
      ENDIF.

      APPEND lv_loghandle TO lt_logh.

